generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  INTERNSHIP_PPO
  PART_TIME
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_SUBMITTED
  STATUS_CHANGED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  JOB_DEADLINE
  NEW_OPPORTUNITY
  COMPANY_APPROVED
  COMPANY_REJECTED
  JOB_APPROVED
  JOB_REJECTED
  NEW_APPLICANT
  ANNOUNCEMENT
  SYSTEM
}

enum AnnouncementTarget {
  ALL_STUDENTS
  ALL_RECRUITERS
  EVERYONE
  DEPARTMENT
}

enum InterviewMode {
  ONLINE
  IN_PERSON
  PHONE
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
  notifications    Notification[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  studentId        String   @unique
  fullName         String
  phone            String?
  avatarUrl        String?
  departmentId     String?
  branch           String?
  cgpa             Float?
  graduationYear   Int?
  semester         Int?
  portfolioUrl     String?
  githubUrl        String?
  linkedinUrl      String?
  resumeUrl        String?
  bio              String?
  preferredJobType JobType?
  preferredLocation String?
  tenthPercent     Float?
  twelfthPercent   Float?
  diplomaPercent   Float?
  activeBacklogs   Int      @default(0)
  totalBacklogs    Int      @default(0)
  workExperience   String?
  internshipExp    String?
  profileComplete  Boolean  @default(false)
  completionPct    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?     @relation(fields: [departmentId], references: [id])
  skills       StudentSkill[]
  certifications Certification[]
  projects     Project[]
  applications Application[]

  @@index([cgpa])
  @@index([graduationYear])
  @@index([departmentId])
}

model Certification {
  id               String   @id @default(cuid())
  studentProfileId String
  name             String
  issuer           String?
  issuedDate       DateTime?
  url              String?
  createdAt        DateTime @default(now())

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Project {
  id               String   @id @default(cuid())
  studentProfileId String
  title            String
  description      String?
  techStack        String?
  url              String?
  createdAt        DateTime @default(now())

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// RECRUITER & COMPANY
// ─────────────────────────────────────────────

model RecruiterProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  fullName      String
  phone         String?
  designation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company?
}

model Company {
  id                  String        @id @default(cuid())
  recruiterId         String        @unique
  name                String
  website             String?
  industry            String?
  description         String?
  logoUrl             String?
  headquarters        String?
  contactPerson       String?
  contactEmail        String?
  contactPhone        String?
  companySize         String?
  linkedinUrl         String?
  verificationDocUrl  String?
  status              CompanyStatus @default(PENDING)
  adminNote           String?
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  jobPostings JobPosting[]

  @@index([status])
}

// ─────────────────────────────────────────────
// JOB POSTING
// ─────────────────────────────────────────────

model JobPosting {
  id               String    @id @default(cuid())
  companyId        String
  title            String
  description      String
  responsibilities String?
  jobType          JobType
  workMode         WorkMode  @default(ON_SITE)
  city             String?
  state            String?
  country          String    @default("India")
  salaryMin        Float?
  salaryMax        Float?
  stipend          Float?
  ppoCTC           Float?
  benefits         String?
  openings         Int       @default(1)
  deadline         DateTime
  selectionRounds  String?
  joiningDate      DateTime?
  status           JobStatus @default(DRAFT)
  adminNote        String?
  publishedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eligibility  JobEligibility?
  skills       JobSkill[]
  applications Application[]

  @@index([status])
  @@index([deadline])
  @@index([companyId])
  @@index([jobType])
}

model JobEligibility {
  id                 String   @id @default(cuid())
  jobPostingId       String   @unique
  minCgpa            Float?
  maxBacklogs        Int?
  allowedDepts       String[]
  allowedGradYears   Int[]
  requiredSkills     String[]
  genderRestriction  String?

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// SKILLS
// ─────────────────────────────────────────────

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  studentSkills StudentSkill[]
  jobSkills     JobSkill[]
}

model StudentSkill {
  studentId String
  skillId   String
  level     String?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
}

model JobSkill {
  jobPostingId String
  skillId      String
  required     Boolean @default(false)

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPostingId, skillId])
}

// ─────────────────────────────────────────────
// APPLICATION
// ─────────────────────────────────────────────

model Application {
  id             String            @id @default(cuid())
  studentId      String
  jobPostingId   String
  resumeSnapshot String?
  coverLetter    String?
  status         ApplicationStatus @default(APPLIED)
  recruiterNote  String?
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  student    StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobPosting JobPosting                 @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  history    ApplicationStatusHistory[]
  interviews Interview[]

  @@unique([studentId, jobPostingId])
  @@index([studentId])
  @@index([jobPostingId])
  @@index([status])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  previousStatus ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String
  note          String?
  changedAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ─────────────────────────────────────────────
// INTERVIEW
// ─────────────────────────────────────────────

model Interview {
  id              String        @id @default(cuid())
  applicationId   String
  roundName       String
  scheduledAt     DateTime
  durationMins    Int?
  mode            InterviewMode
  meetingLink     String?
  location        String?
  interviewerName String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────

model Announcement {
  id            String             @id @default(cuid())
  title         String
  content       String
  target        AnnouncementTarget
  targetDeptId  String?
  priority      Int                @default(0)
  publishAt     DateTime           @default(now())
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime           @default(now())

  @@index([target])
  @@index([publishAt])
}

// ─────────────────────────────────────────────
// DEPARTMENTS
// ─────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  students StudentProfile[]
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
